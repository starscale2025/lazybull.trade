# lazybull environment template — copy to .env.local and fill in.
# .env.local is gitignored; never commit real values.
#
# After deploying, run `node scripts/verify-prod.mjs https://your-host` — it
# asserts from the outside that this file's PRODUCTION half is actually set
# (auth gates live, KV limiter fleet-wide, headers shipped, no key in a bundle)
# and prints the handful of checks no HTTP request can make. Nothing else
# proves the deployed environment matches this template.

# ── MongoDB (required for auth, workspaces, watchlists, paper sync) ──
# Atlas free M0: create cluster → Database Access user → Network Access
# 0.0.0.0/0 (dev) → "Connect your application" connection string.
MONGODB_URI=
# Database name (defaults to "lazybull" if unset).
MONGODB_DB=lazybull

# ── Auth.js / NextAuth v5 (required for sign-in) ──
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized JavaScript origin:  http://localhost:3000
# Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# PRODUCTION ONLY — canonical origin, e.g. https://lazybull.trade. When set it
# pins every Auth.js callback/redirect URL to this origin instead of deriving
# them from the inbound Host header (threat model R-11). LEAVE THIS BLANK
# LOCALLY: a non-localhost origin here breaks the local Google callback.
# Unset in production = Host-derived URLs, which is safe on Vercel because it
# normalizes Host — so the startup warning in lib/auth.ts is suppressed there
# and fires only on a self-host that left this blank. Set it before any
# self-host. NEXTAUTH_URL is honored as the v4 alias; prefer AUTH_URL.
AUTH_URL=

# ── Live market data (chain: Alpaca → Twelve Data → Finnhub → Yahoo → cache) ──
# All optional. With none set the app runs on Yahoo + a synthetic fallback; each
# key added makes the chain more real-time and more resilient. Server-side only.
# See lib/market-data/ and docs/superpowers/specs/2026-07-24-market-data-layer-design.md
#
# PRIMARY — Alpaca (free "Basic": real-time IEX quotes + bars + crypto, no card).
# alpaca.markets → generate API keys. Flip ALPACA_FEED to "sip" for the paid
# full consolidated tape — no code change.
ALPACA_KEY_ID=
ALPACA_SECRET=
ALPACA_FEED=iex
# SECONDARY — Twelve Data (also serves indices like VIX/SPX that Alpaca can't).
# Free tier (no card): twelvedata.com → API key.
TWELVE_DATA_API_KEY=
# TERTIARY — Finnhub (real-time US quotes; free tier has no historical candles).
FINNHUB_API_KEY=
#
# Cross-invocation cache for last-good stale-serve (stops "OFFLINE" flapping when
# a provider blips). Vercel KV or Upstash Redis REST. Unset = in-memory only
# (fine locally; no cross-cold-start stale-serve until this is set).
#
# ALSO the store behind the fleet-wide AI rate limiter (R-01). Unset in
# PRODUCTION and every cap in lib/rate-limit.ts degrades to per-instance —
# i.e. multiplied by however many instances are warm — and the app logs
# "rate-limit: degraded to per-instance limiting". /api/status reporting
# cacheBackend "memory" instead of "kv" is the same signal from outside.
# lib/kv.ts accepts UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN under
# those names too, so an Upstash-direct deploy needs no renaming; set one pair
# or the other, not both.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Optional: AI surfaces ──
# /api/explain + the OpenAI voice co-pilot. Unset = deterministic mock
# explanations, voice unavailable.
OPENAI_API_KEY=
# Free voice engine "brain" proxy (/api/voice/brain).
OPENROUTER_API_KEY=
# Override the OpenRouter model list (optional). Also the privacy lever: the
# default list is `:free` variants, which OpenRouter only serves to accounts
# that allow prompt logging (R-10, disclosed in /privacy clause 05). Pinning a
# paid model here — no `:free` suffix — is what actually stops retention.
OPENROUTER_MODEL=
# Voice endpoint access (/api/realtime/session + /api/voice/brain). Both spend
# real OpenAI/OpenRouter budget, so they REQUIRE a signed-in session by default.
# "1" = open them to anonymous visitors (the old public-demo behavior).
VOICE_ALLOW_ANON=
# "1" = force auth on regardless; wins over VOICE_ALLOW_ANON if both are set.
VOICE_REQUIRE_AUTH=
# Voice provider the client should use: "free" (OpenRouter) or "openai".
NEXT_PUBLIC_VOICE_PROVIDER=

# ── Optional: admin + quant AI service ──
# Comma-separated emails allowed into /admin. AUTHORITATIVE when non-empty: it
# REPLACES the allow-list rather than extending it, so omitting the founder's
# address here revokes the founder (that's the point — R-07). Unset, blank, or
# separators only = fall back to the founder list in lib/admin.ts, so an
# unconfigured deploy still lets its owner in.
ADMIN_EMAILS=
# FastAPI quant service base URL; unset = deterministic AI-bot mocks. Read at
# build time by proxy.ts too — when set, its origin joins the CSP connect-src.
NEXT_PUBLIC_QUANTAI_URL=
