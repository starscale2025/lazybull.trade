# lazybull environment template — copy to .env.local and fill in.
# .env.local is gitignored; never commit real values.

# ── MongoDB (required for auth, workspaces, watchlists, paper sync) ──
# Atlas free M0: create cluster → Database Access user → Network Access
# 0.0.0.0/0 (dev) → "Connect your application" connection string.
MONGODB_URI=
# Database name (defaults to "lazybull" if unset).
MONGODB_DB=lazybull

# ── Auth.js / NextAuth v5 (required for sign-in) ──
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized JavaScript origin:  http://localhost:3000
# Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Optional: AI surfaces ──
# /api/explain + the OpenAI voice co-pilot. Unset = deterministic mock
# explanations, voice unavailable.
OPENAI_API_KEY=
# Free voice engine "brain" proxy (/api/voice/brain).
OPENROUTER_API_KEY=
# Override the OpenRouter model list (optional).
OPENROUTER_MODEL=
# "1" = voice endpoints require a signed-in session.
VOICE_REQUIRE_AUTH=
# Voice provider the client should use: "free" (OpenRouter) or "openai".
NEXT_PUBLIC_VOICE_PROVIDER=

# ── Optional: admin + quant AI service ──
# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=
# FastAPI quant service base URL; unset = deterministic AI-bot mocks.
NEXT_PUBLIC_QUANTAI_URL=
