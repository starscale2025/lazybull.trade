# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# the template with names+comments only is the one env file that SHOULD ship
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI Models and Weights
*.pkl
*.pt
ai quants/weights/

# scroll-cinema intermediates (the served shots in public/cinema/shots ARE committed)
scripts/cinema/shots/
scripts/cinema/raw/
scripts/cinema/bull.mp4

# local tooling
.claude/

# Security working documents — deliberately NOT published.
# This repo is public. The threat model enumerates the app's trust boundaries
# and, more to the point, the risks still OPEN against a live deployment; that
# is a prioritised target list for anyone who reads it. Fixed code is safe to
# publish (a closed hole helps nobody); the list of open ones is not.
# Keep it local, or move it somewhere private. See scripts/verify-prod.mjs for
# the parts that are safe to share.
docs/THREAT_MODEL.md
