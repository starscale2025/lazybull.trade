{"nodes": [{"id": "12_critic_redteam_doc", "label": "Completeness Critic / Red-Team review of the strategy package", "file_type": "document", "source_file": "docs/strategy/12-critic-redteam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "12_critic_redteam_power_tier_contradiction", "label": "Contradiction #1: the $59 Power tier is simultaneously killed (Brand), kept as ARPU anchor (Monetization), AI-roadmap hero (Build E), and on the live pricing page (90-Day Plan)", "file_type": "rationale", "rationale": "These cannot all be true; if Power is killed at launch the $28 ARPU must be recomputed and Build E's gating must move to Pro or be deferred \u2014 as written the package double-counts a tier it claims to kill.", "source_file": "docs/strategy/12-critic-redteam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "12_critic_redteam_broker_number_conflict", "label": "Contradiction #4: broker pilot valued at ~$0.5M in the revenue model but ~$18-48k in the Growth section \u2014 10x apart", "file_type": "rationale", "rationale": "If the realistic pilot is ~$30k, the '$1.3M combined by M12' base case collapses to ~$0.84M and the crossed-a-million milestone is false; reconcile to one broker number.", "source_file": "docs/strategy/12-critic-redteam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "12_critic_redteam_free_tier_conflict", "label": "Contradiction #8: free-tier limits incompatible across sections \u2014 Monetization walls the 4th paper trade; the 90-Day Plan makes paper trades unlimited and gates saves/AI calls", "file_type": "rationale", "rationale": "The primary paywall trigger in one section does not exist in the other; the admin funnel's 'Opened paper trade \u2192 Hit pro paywall' edge depends on which is real \u2014 the single most important product decision in the funnel, specified two incompatible ways.", "source_file": "docs/strategy/12-critic-redteam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "12_critic_redteam_canonical_assumptions", "label": "Meta-gap: no single source of truth \u2014 ARPU, conversion %, free-tier limits, broker ARR, accuracy %, signup targets and the 91% stat each differ across sections", "file_type": "rationale", "rationale": "For a package whose pitch is 'clean diligence / un-fakeable numbers', the internal inconsistency would itself fail diligence; one locked canonical-assumptions table is required, plus a named verification owner for 'verified against code' claims that reached contradictory conclusions.", "source_file": "docs/strategy/12-critic-redteam.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "12_critic_redteam_doc", "target": "12_critic_redteam_power_tier_contradiction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/strategy/12-critic-redteam.md", "source_location": null, "weight": 1.0}, {"source": "12_critic_redteam_doc", "target": "12_critic_redteam_broker_number_conflict", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/strategy/12-critic-redteam.md", "source_location": null, "weight": 1.0}, {"source": "12_critic_redteam_doc", "target": "12_critic_redteam_free_tier_conflict", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/strategy/12-critic-redteam.md", "source_location": null, "weight": 1.0}, {"source": "12_critic_redteam_doc", "target": "12_critic_redteam_canonical_assumptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/strategy/12-critic-redteam.md", "source_location": null, "weight": 1.0}, {"source": "12_critic_redtea