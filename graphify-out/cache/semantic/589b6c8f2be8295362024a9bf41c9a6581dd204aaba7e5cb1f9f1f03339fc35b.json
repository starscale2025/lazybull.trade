{"nodes": [{"id": "cinema_test_acts", "label": "describe: ACTS", "file_type": "code", "source_file": "__tests__/cinema.test.ts", "source_location": "18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "cinema_test_acts_cover_0_1_contiguously", "label": "acts cover [0,1] contiguously in ACT_ORDER", "file_type": "code", "source_file": "__tests__/cinema.test.ts", "source_location": "19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A gap or overlap between consecutive act windows leaves a scroll position with no owning act, so the cinema renders nothing (black frame) at that progress value."}, {"id": "cinema_test_acts_positive_width", "label": "every act has positive width", "file_type": "code", "source_file": "__tests__/cinema.test.ts", "source_location": "27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A zero- or negative-width act would be unreachable by scroll and would break the contiguity arithmetic."}, {"id": "cinema_test_copy_beats", "label": "describe: COPY_BEATS", "file_type": "code", "source_file": "__tests__/cinema.test.ts", "source_location": "32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "cinema_test_copy_beats_unique_ids_in_range", "label": "copy beats have unique ids and windows inside [0,1]", "file_type": "code", "source_file": "__tests__/cinema.test.ts", "source_location": "33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Duplicate beat ids collide on lookup and a window escaping [0,1] is unreachable scroll territory, so the copy never shows."}, {"id": "cinema_test_copy_beats_inside_act_window", "label": "each copy beat sits within some act window", "file_type": "code", "source_file": "__tests__/cinema.test.ts", "source_location": "42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A beat spanning an act boundary shows its copy over the wrong visual layer as the acts crossfade."}, {"id": "cinema_test_clamp01", "label": "describe: clamp01", "file_type": "code", "source_file": "__tests__/cinema.test.ts", "source_location": "50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "cinema_test_clamp01_neutralizes_non_finite", "label": "clamp01 clamps and neutralizes non-finite input", "file_type": "code", "source_file": "__tests__/cinema.test.ts", "source_location": "51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NaN and Infinity must collapse to 0 rather than propagate: a NaN opacity makes the whole layer vanish or flicker unpredictably in the compositor."}, {"id": "cinema_test_beatopacity", "label": "describe: beatOpacity", "file_type": "code", "source_file": "__tests__/cinema.test.ts", "source_location": "60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "cinema_test_beatopacity_zero_outside_window", "label": "beatOpacity is 0 outside the window (inclusive edges)", "file_type": "code", "source_file": "__tests__/cinema.test.ts", "source_location": "62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pins exact edge semantics: at from and at to the beat is already fully transparent, so adjacent beats never double-render at a shared boundary."}, {"id": "cinema_test_beatopacity_ramps_and_plateaus", "label": "beatOpacity ramps over the fade width and plateaus at 1", "file_type": "code", "source_file": "__tests__/cinema.test.ts", "source_location": "68", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The fade must be a trapezoid \u2014 linear in, flat hold, linear out \u2014 not a triangle that never reaches full opacity."}, {"id": "cinema_test_flashopacity", "lab